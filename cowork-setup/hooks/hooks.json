{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-check.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-check.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-check.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
