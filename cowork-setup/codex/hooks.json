{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/session-start.py\" || python \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/session-start.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/session-start.py\"",
            "timeout": 120,
            "commandWindows": "py -3 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','session-start.py'),run_name='__main__')\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/stop-check.py\" || python \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/stop-check.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/stop-check.py\"",
            "timeout": 90,
            "commandWindows": "py -3 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','stop-check.py'),run_name='__main__')\""
          }
        ]
      }
    ]
  }
}
